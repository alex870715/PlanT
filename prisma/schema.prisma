generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Trip {
  id        String   @id @default(cuid())
  seedCode  String   @unique @db.Char(6)
  title     String
  startDate DateTime
  endDate   DateTime
  /** ISO 4217 幣別代碼，整趟旅程共用 */
  currency  String   @default("TWD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  spots       Spot[]
  members     Member[]
  tasks       TripTask[]
  expenses    TripExpense[]
  settlements TripSettlement[]
  activities  TripActivityLog[]
  presences   TripMemberPresence[]
}

model MatchRoom {
  id               String   @id @default(cuid())
  roomCode         String   @unique @db.Char(6)
  destinationSlug  String
  destinationLabel String
  startDate        DateTime
  endDate          DateTime
  hostName         String   @default("探索隊長")
  votingEndsAt     DateTime?
  plantedSeedCode  String?  @db.Char(6)
  createdAt        DateTime @default(now())

  votes MatchVote[]
}

model MatchVote {
  id        String   @id @default(cuid())
  roomId    String
  cardId    String
  voterName String
  vote      String   @db.Char(4)
  createdAt DateTime @default(now())

  room MatchRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, cardId, voterName])
  @@index([roomId])
}

model TripTask {
  id        String   @id @default(cuid())
  tripId    String
  title     String
  category  String   @default("booking")
  assignee  String?
  amount    Decimal? @db.Decimal(12, 2)
  notes     String?
  done      Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  trip          Trip                   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  attachments   TripTaskAttachment[]
  confirmations TripTaskConfirmation[]

  @@index([tripId])
}

model TripTaskAttachment {
  id         String   @id @default(cuid())
  taskId     String
  fileName   String
  mimeType   String
  /** base64 圖片資料（不含 data: 前綴） */
  data       String   @db.Text
  uploadedBy String?
  createdAt  DateTime @default(now())

  task TripTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model TripTaskConfirmation {
  id         String   @id @default(cuid())
  taskId     String
  memberId   String
  memberName String
  createdAt  DateTime @default(now())

  task TripTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, memberId])
  @@index([taskId])
}

model TripExpense {
  id               String   @id @default(cuid())
  tripId           String
  title            String
  /** 實際付款金額，以 `currency` 計價 */
  amount           Decimal  @db.Decimal(14, 2)
  /** 此筆花費實際支付的幣別（ISO 4217） */
  currency         String   @default("TWD")
  /** 換算成旅程基準幣別的匯率：baseAmount = amount * exchangeRate */
  exchangeRate     Decimal  @default(1) @db.Decimal(16, 6)
  paidByMemberId   String
  /** JSON string[] of member ids who share this expense */
  splitMemberIds   Json
  notes            String?
  createdAt        DateTime @default(now())

  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  paidBy Member @relation(fields: [paidByMemberId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([paidByMemberId])
}

model TripSettlement {
  id           String   @id @default(cuid())
  tripId       String
  fromMemberId String
  toMemberId   String
  /** 標記完成當下的金額（旅程基準幣別），用於偵測金額變動 */
  amount       Decimal  @db.Decimal(14, 2)
  done         Boolean  @default(true)
  createdAt    DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, fromMemberId, toMemberId])
  @@index([tripId])
}

model Spot {
  id        String   @id @default(cuid())
  tripId    String
  memberId  String?
  name      String
  latitude  Float
  longitude Float
  openHours String?
  phone     String?
  notes        String?
  scheduledAt  DateTime?
  /** 從上一站到此站的交通方式：walk / transit / drive / taxi / bike */
  travelMode    String?
  travelMinutes Int?
  isTrunk      Boolean   @default(true)
  sortOrder    Int       @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trip   Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  member Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([tripId])
  @@index([memberId])
}

model Member {
  id        String   @id @default(cuid())
  tripId    String
  name      String
  email     String?
  createdAt DateTime @default(now())

  trip         Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  spots        Spot[]
  paidExpenses TripExpense[]
  activities   TripActivityLog[]
  presences    TripMemberPresence[]

  @@index([tripId])
}

model TripActivityLog {
  id         String   @id @default(cuid())
  tripId     String
  memberId   String?
  memberName String
  action     String
  targetType String?
  targetId   String?
  detail     String?
  createdAt  DateTime @default(now())

  trip   Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  member Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([tripId, createdAt])
}

/** 出發日：團員即時狀態（到了 / 晚到 / 出發中） */
model TripMemberPresence {
  id          String   @id @default(cuid())
  tripId      String
  memberId    String
  memberName  String
  /** idle | on_way | arrived | late */
  status      String   @default("idle")
  lateMinutes Int?
  spotId      String?
  message     String?
  updatedAt   DateTime @updatedAt

  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([tripId, memberId])
  @@index([tripId])
}
